// Terms the sampled prose names by title or alias, and ones it does not.

term t_plugin "Plugin" {
  definition "An extension the host loads; a Chain of them is no Plugin."
}

term t_eleve "Élève" {
  definition "A pupil."
}

term t_caf "Caf" {
  definition "Never named: only café is written."
}

term t_entity_graph "Entity Graph" {
  definition "The graph of entities."
}

term t_box "Box" {
  definition "Named by its alias."
  aliases    ["sandbox"]
}

term component "Wasm Component Model" {
  definition "Its id is a word the sampled prose writes; its title is written nowhere."
}

term work_item "Task" {
  definition "A unit of work: its id is not its name, so its title is what the prose names."
}

term t_chain "Chain" {
  definition "Named only by another term and an unsampled failure mode."
}

term t_release_train "Release Train" {
  definition "Written only across two fields: the end of one and the start of the next."
}
