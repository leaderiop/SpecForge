package specforge:host@0.1.0;

/// Why a port call did not run, or how it failed.
interface types {
  /// The host refused the call before any effect.
  variant denial {
    /// This call kind may not use the port (a pass, a validator, a hook, ...): the message says who may.
    call-kind(string),
    /// The request is outside the extension's grant for this call: the message names what was asked.
    scope(string),
  }
  /// The port did not answer: `class` is the journal's outcome class (`unreachable:dns`, `deadline`, `missing`, ...).
  record failure {
    class: string,
    message: string,
  }
  variant host-error {
    denied(denial),
    failed(failure),
  }
}

/// One request; redirects are followed by the host, each hop granted again.
interface http {
  use types.{host-error};
  record header {
    name: string,
    value: string,
    sensitive: bool,
  }
  /// `body-cap` and `timeout-ms` are held to the host's ceilings; 0 asks for the most the call may have.
  record request {
    method: string,
    url: string,
    headers: list<header>,
    body: option<list<u8>>,
    body-cap: u64,
    timeout-ms: u64,
    max-redirects: u32,
    keep-headers: list<string>,
  }
  record response-header {
    name: string,
    value: string,
  }
  /// An answer that came, whatever its status. `truncated`: the body stopped at a cap.
  record response {
    status: u16,
    headers: list<response-header>,
    body: list<u8>,
    truncated: bool,
    final-url: string,
  }
  send: func(req: request) -> result<response, host-error>;
}

/// Reads under a named root (`spec`, `project` or a root `specforge.json` names).
interface fs {
  use types.{host-error};
  enum entry-kind {
    file,
    dir,
    other,
  }
  record entry {
    kind: entry-kind,
    size: u64,
    modified-ms: option<u64>,
  }
  record content {
    bytes: list<u8>,
    truncated: bool,
  }
  record listing {
    entries: list<string>,
    truncated: bool,
  }
  /// None: the path does not exist.
  stat: func(root: string, path: string) -> result<option<entry>, host-error>;
  read: func(root: string, path: string, max-bytes: u64) -> result<content, host-error>;
  walk: func(root: string, path: string, glob: option<string>, max-entries: u32) -> result<listing, host-error>;
}

/// One program, its argv as a capability declares it, in the project's directory.
interface process {
  use types.{host-error};
  /// `value` none: the variable is removed.
  record env-var {
    name: string,
    value: option<string>,
  }
  /// `deadline-ms` and `output-cap` are held to the host's ceilings; 0 asks for the most the call may have.
  record run-request {
    argv: list<string>,
    env: list<env-var>,
    stdin: option<list<u8>>,
    deadline-ms: u64,
    output-cap: u64,
    text: bool,
  }
  /// A run that ended. `exit-code` none: it was stopped at the output cap, and `truncated` says so.
  record run-output {
    exit-code: option<s32>,
    stdout: list<u8>,
    stderr: list<u8>,
    truncated: bool,
  }
  run: func(req: run-request) -> result<run-output, host-error>;
}

/// Reads of the project's repository: no write, and no place to name another one.
interface git {
  use types.{host-error};
  record repo {
    toplevel: string,
    shallow: bool,
  }
  record tree-entry {
    path: string,
    file: bool,
  }
  record file-size {
    path: string,
    size: option<u64>,
  }
  record blob {
    path: string,
    bytes: option<list<u8>>,
  }
  /// `truncated`: the answer's cap stopped them; the blobs after it have no bytes.
  record blobs-answer {
    blobs: list<blob>,
    truncated: bool,
  }
  record branch-status {
    oid: option<string>,
    head: option<string>,
    upstream: option<string>,
    ahead: u32,
    behind: u32,
  }
  enum entry-kind {
    changed,
    renamed,
    unmerged,
    untracked,
    ignored,
  }
  enum change {
    modified,
    type-changed,
    added,
    deleted,
    renamed,
    copied,
    unmerged,
  }
  record entry {
    kind: entry-kind,
    path: string,
    orig-path: option<string>,
    index: option<change>,
    worktree: option<change>,
  }
  record status-answer {
    branch: branch-status,
    entries: list<entry>,
  }
  /// One changed range of a diff, no context: old lines `before-start..before-end` became new lines
  /// `after-start..after-end` (0-based, end exclusive).
  record hunk {
    before-start: u32,
    before-end: u32,
    after-start: u32,
    after-end: u32,
  }
  /// The commits `tips` reach that `hidden` do not, newest first: commits by id, paths from the repository's top.
  /// `max` none lists every commit the answer holds. `since` and `until` are seconds since the epoch.
  record log-query {
    tips: list<string>,
    hidden: list<string>,
    paths: list<string>,
    first-parent: bool,
    max: option<u32>,
    oldest: bool,
    grep: option<string>,
    since: option<s64>,
    until: option<s64>,
    no-merges: bool,
    pickaxe: option<string>,
  }
  record signature {
    name: string,
    email: string,
    /// ISO 8601 with the signer's offset.
    time: string,
    seconds: s64,
  }
  /// A trailer of the message's last paragraph: every value of its token, in order.
  record trailer {
    token: string,
    values: list<string>,
  }
  record log-commit {
    sha: string,
    parents: list<string>,
    author: signature,
    committer: signature,
    subject: string,
    body: string,
    trailers: list<trailer>,
  }
  /// `count`: every commit the log keeps (none past a pickaxe's listing, or when the walk stopped). `truncated`: the
  /// answer's cap stopped the listing, or the host's counted walk stopped (then no `count`).
  record log-answer {
    count: option<u64>,
    commits: list<log-commit>,
    truncated: bool,
  }
  variant diff-head {
    commit(string),
    index,
    worktree,
  }
  /// `base` none: the empty tree (a root commit's diff). `hunks`: each text file's changed line ranges. `renames`
  /// pairs renames by the host's rules, never the repository's config; false lists a rename as a deletion and an
  /// addition.
  record diff-query {
    base: option<string>,
    head: diff-head,
    paths: list<string>,
    patch: bool,
    hunks: bool,
    renames: bool,
  }
  /// `withheld`: a file whose text this guest may not read (a withheld name, or a worktree file its fs grant does not
  /// read); it has no patch and no hunks, its status and counts stay. `truncated`: a side over the blob cap, a cut
  /// patch, or a file past the bytes the host reads for one diff (no lines counted).
  record file-change {
    path: string,
    old-path: option<string>,
    status: change,
    added: u32,
    removed: u32,
    binary: bool,
    truncated: bool,
    withheld: bool,
    patch: option<string>,
    hunks: option<list<hunk>>,
  }
  /// `truncated`: the answer's cap stopped the patches, so the files after it have none, or the host's counted read
  /// stopped, so the files past it count no lines.
  record diff-answer {
    files: list<file-change>,
    truncated: bool,
  }
  /// None: the project is in no repository.
  locate: func() -> result<option<repo>, host-error>;
  /// The commit a revision names; none when it names none.
  commit: func(revision: string) -> result<option<string>, host-error>;
  merge-base: func(a: string, b: string) -> result<option<string>, host-error>;
  tree: func(commit: string, dir: string) -> result<list<tree-entry>, host-error>;
  sizes: func(commit: string, paths: list<string>) -> result<list<file-size>, host-error>;
  blobs: func(commit: string, paths: list<string>) -> result<blobs-answer, host-error>;
  branch: func() -> result<string, host-error>;
  status: func() -> result<status-answer, host-error>;
  /// The log of the project's repository; a pickaxe never reads a withheld file.
  log: func(query: log-query) -> result<log-answer, host-error>;
  /// A diff of the project's repository; a withheld file's text is never in it, nor a worktree file's the fs grant
  /// does not read.
  diff: func(query: diff-query) -> result<diff-answer, host-error>;
}

/// Source files parsed by the host's reader with the guest's tags query, inside the call's fs grant (git's at a
/// revision). A file not parsed says why; the answer keeps the order asked.
interface syntax {
  use types.{host-error};
  /// Where the files are read: under a named root, or in a commit of the project's repository.
  variant read-at {
    worktree(string),
    revision(string),
  }
  /// The files asked: named, or every file a glob matches.
  variant file-set {
    paths(list<string>),
    glob(string),
  }
  /// `language`: `rust`, `typescript` or `tsx`. `query`: one role capture per pattern
  /// (`definition.<kind>` or `reference.<kind>`); every capture not starting with `_` is answered.
  record request {
    source: read-at,
    files: file-set,
    language: string,
    query: string,
  }
  /// `byte` from 0; `line`, `col` (characters) and `byte-col` from 1.
  record point {
    byte: u32,
    line: u32,
    col: u32,
    byte-col: u32,
  }
  record span {
    start: point,
    end: point,
  }
  enum role {
    definition,
    reference,
  }
  /// `cut`: the text stopped at the host's capture cap.
  record capture {
    name: string,
    text: string,
    cut: bool,
    span: span,
  }
  /// `parent`: the index of the innermost match holding this one.
  record syntax-match {
    role: role,
    kind: string,
    span: span,
    parent: option<u32>,
    captures: list<capture>,
  }
  /// `errors`: the syntax errors the parse recovered from.
  record parsed {
    matches: list<syntax-match>,
    errors: u32,
  }
  enum not-parsed {
    deadline,
    too-large,
    missing,
    unreadable,
    denied,
    capped,
  }
  variant outcome {
    parsed(parsed),
    not-parsed(not-parsed),
  }
  record file {
    path: string,
    digest: option<string>,
    outcome: outcome,
  }
  /// `truncated`: a glob's walk stopped short, so the files past it are not in the answer (a file the answer's cap
  /// stopped is `not-parsed(capped)`). `parsed` and `cached`: files parsed now and answered from the host's cache.
  record syntax-answer {
    files: list<file>,
    truncated: bool,
    parsed: u32,
    cached: u32,
  }
  parse: func(req: request) -> result<syntax-answer, host-error>;
}

world ports {
  import http;
  import fs;
  import process;
  import git;
  import syntax;
}
