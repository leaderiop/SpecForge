{
  "category": "collectors",
  "items": [
    {
      "answers": [
        "static_finding"
      ],
      "auto_detect": {
        "env_vars": [],
        "file_patterns": [
          "eslint.config.*"
        ]
      },
      "capability": "javascript-lint",
      "export": "collect__javascript_lint",
      "input_formats": [
        "sarif"
