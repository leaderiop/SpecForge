            "item",
            "package"
          ]
        }
      ],
      "install": "npm install --save-dev eslint @microsoft/eslint-formatter-sarif",
      "name": "javascript-lint",
      "report": ".specforge/reports/javascript-lint.sarif"
    }
  ]
}