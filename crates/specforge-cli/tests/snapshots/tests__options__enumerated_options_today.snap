---
source: crates/specforge-cli/tests/options.rs
expression: "sections.join(\"\\n\")"
---
## export format
cli -h: --format <FORMAT> Output format [default: graph] [possible values: graph, context, brief, dot]
mcp schema: enum ["graph","context","brief"] default "graph"
default: cli=graph = json mcp=graph = json
graph                        cli=0   mcp=ok
context                      cli=0   mcp=ok
brief                        cli=0   mcp=ok
dot                          cli=0   mcp=refused: invalid_input: Unknown format: dot. Expected: graph, context, brief
json                         cli=0   mcp=ok
yaml                         cli=2   mcp=refused: invalid_input: Unknown format: yaml. Expected: graph, context, brief

## schema publish format
cli -h: --format <FORMAT> Export format the published schema should describe [default: graph] [possible values: graph, context, brief]
default: cli=graph = json
graph                        cli=0   mcp=-
context                      cli=0   mcp=-
brief                        cli=0   mcp=-
dot                          cli=2   mcp=-
json                         cli=0   mcp=-

## model format
cli -h: --format <FORMAT> Output format [default: markdown] [possible values: markdown, mermaid, dot, json, dbml]
mcp schema: enum ["markdown","mermaid","dot","json","dbml"] default null
default: cli=markdown mcp=markdown
markdown                     cli=0   mcp=ok
mermaid                      cli=0   mcp=ok
dot                          cli=0   mcp=ok
json                         cli=0   mcp=ok
dbml                         cli=0   mcp=ok
svg                          cli=2   mcp=refused: invalid_input: Unknown format: svg. Expected: markdown, mermaid, dot, json, dbml

## model group_by
cli -h: --group-by <GROUP_BY> How to group entities [default: extension] [possible values: extension, none]
mcp schema: enum ["extension","none"] default null
default: cli=extension mcp=extension
extension                    cli=0   mcp=ok
none                         cli=0   mcp=ok
flat                         cli=2   mcp=refused: invalid_input: Unknown group_by: flat. Expected: extension, none

## model fields
cli -h: --fields <FIELDS> Field detail level [default: keys] [possible values: none, keys, all]
mcp schema: enum ["none","keys","all"] default null
default: cli=keys mcp=keys
none                         cli=0   mcp=ok
keys                         cli=0   mcp=ok
all                          cli=0   mcp=ok
some                         cli=2   mcp=refused: invalid_input: Unknown fields: some. Expected: none, keys, all

## outline format
cli -h: --format <FORMAT> Output format [default: markdown] [possible values: markdown, mermaid, dot, json]
mcp schema: enum ["markdown","mermaid","dot","json"] default null
default: cli=markdown mcp=markdown
markdown                     cli=0   mcp=ok
mermaid                      cli=0   mcp=ok
dot                          cli=0   mcp=ok
json                         cli=0   mcp=ok
svg                          cli=2   mcp=refused: invalid_input: Unknown format: svg. Expected: markdown, mermaid, dot, json

## outline fields
cli -h: --fields <FIELDS> Detail level [default: keys] [possible values: none, keys, all]
mcp schema: enum ["none","keys","all"] default null
default: cli=keys mcp=keys
none                         cli=0   mcp=ok
keys                         cli=0   mcp=ok
all                          cli=0   mcp=ok

## outline deps
cli -h: --deps <DEPS> Dependency visibility [default: direct] [possible values: direct, effective, full]
mcp schema: enum ["direct","effective","full"] default null
default: cli=direct = effective mcp=direct = effective
direct                       cli=0   mcp=ok
effective                    cli=0   mcp=ok
full                         cli=0   mcp=ok
transitive                   cli=2   mcp=refused: invalid_input: Unknown deps: transitive. Expected: direct, effective, full

## render format
mcp schema: enum ["json","dot","context","brief"] default null (required)
default: mcp=json
json                         cli=-   mcp=ok
graph                        cli=-   mcp=refused: invalid_input: Unrecognized renderer format: graph (available: json, dot, context, brief) (available_renderers: ["json","dot","context","brief"])
dot                          cli=-   mcp=ok
context                      cli=-   mcp=ok
brief                        cli=-   mcp=ok
yaml                         cli=-   mcp=refused: invalid_input: Unrecognized renderer format: yaml (available: json, dot, context, brief) (available_renderers: ["json","dot","context","brief"])

## query format
mcp schema: enum null default "graph"
default: mcp=graph = json = dot = yaml
graph                        cli=-   mcp=ok
context                      cli=-   mcp=ok
brief                        cli=-   mcp=ok
json                         cli=-   mcp=ok
dot                          cli=-   mcp=ok
yaml                         cli=-   mcp=ok

## coverage status_filter
mcp schema: enum ["covered","partial","uncovered"] default null
default: mcp=uncovered
covered                      cli=-   mcp=ok
partial                      cli=-   mcp=ok
uncovered                    cli=-   mcp=ok
coverd                       cli=-   mcp=refused: invalid_input: unknown coverage status 'coverd' (expected one of: covered, partial, uncovered) (suggestion: did you mean 'covered'?)

## find_references direction
mcp schema: enum ["incoming","outgoing","both"] default "incoming"
default: mcp=incoming
incoming                     cli=-   mcp=ok
outgoing                     cli=-   mcp=ok
both                         cli=-   mcp=ok
sideways                     cli=-   mcp=refused: invalid_input: unknown direction 'sideways': expected "incoming", "outgoing" or "both"

## analyze pass
cli -h: [PASS] Analysis pass to run (all, coverage, contracts) [possible values: all, coverage, contracts]
mcp schema: enum null default null
default: cli=all mcp=all
all                          cli=0   mcp=ok
coverage                     cli=0   mcp=ok
contracts                    cli=0   mcp=ok
@specforge/testing:coverage  cli=2   mcp=ok
nosuch                       cli=2   mcp=refused: invalid_input: Unknown analysis pass 'nosuch' (available: all, coverage, contracts, @specforge/testing:coverage)
