---
source: crates/specforge-mcp/tests/tool_arguments.rs
expression: listing
---
[
  {
    "name": "specforge.query",
    "description": "Query the graph at multiple resolutions",
    "inputSchema": {
      "properties": {
        "depth": {
          "default": 1,
          "description": "Number of hops (default 1)",
          "type": "integer"
        },
        "entity_id": {
          "description": "Entity ID to query",
          "type": "string"
        },
        "format": {
          "default": "graph",
          "description": "Output detail level: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title",
          "enum": [
            "graph",
            "context",
            "brief",
            "json"
          ],
          "type": "string"
        },
        "include_coverage": {
          "default": false,
          "description": "Include coverage metadata in the response",
          "type": "boolean"
        },
        "kinds": {
          "description": "Filter by entity kinds",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "edges": {
          "type": "array"
        },
        "format_version": {
          "type": "string"
        },
        "nodes": {
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.validate",
    "description": "Recompile and validate the spec project",
    "inputSchema": {
      "properties": {
        "lint": {
          "description": "Extra lint profiles, as `specforge check --lint` takes (inferred: I200/I202 from specforge-infer.json; pedantic is the default and adds nothing)",
          "items": {
            "description": "A lint profile",
            "enum": [
              "inferred",
              "pedantic"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "Project root path (uses initialized root if omitted)",
          "type": "string"
        },
        "severity_filter": {
          "description": "Only report diagnostics of this severity, after strict promotion (case-insensitive). The verdict in _meta[\"specforge/check\"] still counts everything reported",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Promote warnings to errors, before severity_filter applies",
          "type": "boolean"
        },
        "use_cached": {
          "default": false,
          "description": "Use the last compile instead of bringing the project up to date with disk; with no project served, the path is compiled anyway",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.analyze",
    "description": "Run analysis passes (coverage: proof obligations and discharge funnel; contracts: clause symmetry) over the compiled project",
    "inputSchema": {
      "properties": {
        "pass": {
          "default": "all",
          "description": "Analysis pass to run: all, coverage, contracts, or a pass an extension declares (`<extension>:<pass>`)",
          "type": "string"
        },
        "path": {
          "description": "Project root path (uses initialized root if omitted)",
          "type": "string"
        },
        "strict": {
          "description": "Promote warnings to errors",
          "type": "boolean"
        },
        "test_results": {
          "description": "Path to a specforge-report.json for proof-level verdicts",
          "type": "string"
        },
        "use_cached": {
          "default": false,
          "description": "Use the last compile instead of bringing the project up to date with disk; with no project served, the path is compiled anyway",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "orphans": {
          "type": "array"
        },
        "passes": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "passes"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.export",
    "description": "Export the graph in various formats",
    "inputSchema": {
      "properties": {
        "format": {
          "default": "graph",
          "description": "Export format: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title",
          "enum": [
            "graph",
            "context",
            "brief",
            "json"
          ],
          "type": "string"
        },
        "max_tokens": {
          "description": "Optional token budget; truncates the export to the most central entities that fit",
          "type": "integer"
        },
        "no_schema": {
          "description": "Leave the schema out of a graph export (Graph Protocol 1.0)",
          "type": "boolean"
        },
        "scope": {
          "description": "Scope to entity subgraph",
          "type": "string"
        },
        "with_schema": {
          "description": "Embed the Graph Protocol schema in a context, brief or budgeted graph export (a full graph export embeds it already); under max_tokens it counts toward the budget",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.trace",
    "description": "Show traceability chain for an entity, or check an agent plan for gaps (entity_id or plan)",
    "inputSchema": {
      "properties": {
        "entity_id": {
          "description": "Entity ID to trace",
          "type": "string"
        },
        "plan": {
          "description": "An agent plan, {\"entries\": [{\"entity_id\": ...}]}, to check for gaps against the graph instead of tracing one entity",
          "type": "object"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "downstream": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "entity_id": {
              "type": "string"
            },
            "entity_kind": {
              "type": "string"
            },
            "missing": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "schema_version": {
              "type": "string"
            },
            "upstream": {
              "items": {
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "schema_version",
            "entity_id",
            "entity_kind",
            "upstream",
            "downstream",
            "missing"
          ],
          "type": "object"
        },
        {
          "properties": {
            "affected_entities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "gaps": {
              "items": {
                "properties": {
                  "gap_context": {
                    "type": "string"
                  },
                  "missing_link_type": {
                    "type": "string"
                  },
                  "source_entity": {
                    "type": "string"
                  },
                  "target_entity": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_entity",
                  "target_entity",
                  "missing_link_type"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "affected_entities",
            "gaps"
          ],
          "type": "object"
        }
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.search",
    "description": "Find entities by id, title or string field text, ranked as the LSP ranks them (exact, prefix, substring, field text, then fuzzy)",
    "inputSchema": {
      "properties": {
        "field": {
          "description": "Only search a specific field",
          "type": "string"
        },
        "kinds": {
          "description": "Filter by kinds",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limit": {
          "default": 20,
          "description": "Max results (default 20)",
          "type": "integer"
        },
        "query": {
          "description": "Search query",
          "type": "string"
        },
        "references": {
          "description": "Only entities that reference this entity ID (combined with the other filters)",
          "type": "string"
        },
        "value": {
          "description": "Exact field value filter (with field)",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.explain",
    "description": "Explain a diagnostic code: its title, owner, level, what triggers it and how to fix it, and its docs link",
    "inputSchema": {
      "properties": {
        "code": {
          "description": "A diagnostic code, any case",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string"
        },
        "docs": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "replaced_by": {
          "properties": {
            "code": {
              "type": "string"
            },
            "docs": {
              "type": [
                "string",
                "null"
              ]
            },
            "explanation": {
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "retired": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "retired"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.schema",
    "description": "Get the GraphProtocolSchema: entity kinds with their typed fields, edge types and the loaded extensions",
    "inputSchema": {
      "properties": {
        "include_edges": {
          "default": true,
          "description": "Include edge type definitions",
          "type": "boolean"
        },
        "include_validation_rules": {
          "default": false,
          "description": "Include the validation rules loaded extensions declare",
          "type": "boolean"
        },
        "kind": {
          "description": "Filter schema to a specific entity kind",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "edge_types": {
          "type": "array"
        },
        "entity_kinds": {
          "type": "array"
        },
        "extensions": {
          "type": "array"
        },
        "schema_version": {
          "type": "object"
        },
        "validation_rules": {
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "extensions",
        "entity_kinds"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.model",
    "description": "Render the logical data model (entity kinds, fields, relationships)",
    "inputSchema": {
      "properties": {
        "depth": {
          "description": "Maximum depth from root kind (requires root)",
          "type": "integer"
        },
        "extension": {
          "description": "Filter to a single extension",
          "type": "string"
        },
        "fields": {
          "default": "keys",
          "description": "Field detail level: none; keys: key fields; all",
          "enum": [
            "none",
            "keys",
            "all"
          ],
          "type": "string"
        },
        "format": {
          "default": "markdown",
          "description": "Output format: markdown; mermaid: ER diagram; dot: Graphviz; json; dbml: dbdiagram.io",
          "enum": [
            "markdown",
            "mermaid",
            "dot",
            "json",
            "dbml"
          ],
          "type": "string"
        },
        "group_by": {
          "default": "extension",
          "description": "How to group entities: extension: under a header per extension; none: one flat list",
          "enum": [
            "extension",
            "none"
          ],
          "type": "string"
        },
        "kinds": {
          "description": "Filter to specific entity kinds",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "Root entity kind for depth-scoped output",
          "type": "string"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.outline_extensions",
    "description": "Renders the extension architecture hierarchy — how extensions relate via dependencies, enhancements, and cross-extension edges. Shows entity kinds, edge types, validation rules, and surface contributions per extension. Use this to understand the project's extension topology before making structural changes.",
    "inputSchema": {
      "properties": {
        "deps": {
          "default": "direct",
          "description": "Dependency visibility: direct: declared only; effective: direct and used transitive; full: all transitive",
          "enum": [
            "direct",
            "effective",
            "full"
          ],
          "type": "string"
        },
        "fields": {
          "default": "keys",
          "description": "Detail level: none: counts only; keys: names and rule codes; all: full field attribution",
          "enum": [
            "none",
            "keys",
            "all"
          ],
          "type": "string"
        },
        "format": {
          "default": "markdown",
          "description": "Output format; json is meant for programs: markdown; mermaid: flowchart; dot: Graphviz; json",
          "enum": [
            "markdown",
            "mermaid",
            "dot",
            "json"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.coverage",
    "description": "Get coverage status per entity",
    "inputSchema": {
      "properties": {
        "entity_id": {
          "description": "Filter to specific entity",
          "type": "string"
        },
        "kind": {
          "description": "Filter by entity kind",
          "type": "string"
        },
        "status_filter": {
          "description": "Only entities with this coverage status: covered: every obligation proven; partial: some obligations proven; uncovered: none proven",
          "enum": [
            "covered",
            "partial",
            "uncovered"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.stats",
    "description": "Get project statistics",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "coverage_pct": {
          "type": "number"
        },
        "declared_pct": {
          "type": "number"
        },
        "diagnostic_summary": {
          "type": "object"
        },
        "edge_count": {
          "type": "integer"
        },
        "entity_counts": {
          "type": "array"
        },
        "orphan_count": {
          "type": "integer"
        },
        "proof_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "entity_counts",
        "declared_pct",
        "proof_pct",
        "edge_count",
        "orphan_count",
        "diagnostic_summary"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.list",
    "description": "List entities sorted by id, optionally filtered by kind and field values, and paged",
    "inputSchema": {
      "properties": {
        "kind": {
          "description": "Filter by entity kind (e.g. 'feature', 'behavior')",
          "type": "string"
        },
        "limit": {
          "description": "Return at most this many entities",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "description": "Skip this many entities first",
          "minimum": 0,
          "type": "integer"
        },
        "where": {
          "additionalProperties": true,
          "description": "Only entities whose fields hold these values, e.g. {\"status\": \"done\"}",
          "type": "object"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.inspect",
    "description": "Get full detail for a specific entity",
    "inputSchema": {
      "properties": {
        "entity_id": {
          "description": "Entity ID to inspect",
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_status": {
          "type": "string"
        },
        "declared": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array"
        },
        "entity_id": {
          "type": "string"
        },
        "exempt": {
          "type": "boolean"
        },
        "fields": {
          "type": "object"
        },
        "kind": {
          "type": "string"
        },
        "obligated": {
          "type": "boolean"
        },
        "reference_count": {
          "type": "integer"
        },
        "referenced_by": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "references": {
          "type": "array"
        },
        "refers_to": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "type": "object"
        },
        "testable": {
          "type": "boolean"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "verify_declarations": {
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "entity_id",
        "kind",
        "testable",
        "declared",
        "exempt",
        "obligated",
        "source_span",
        "fields",
        "referenced_by",
        "refers_to",
        "references",
        "coverage_status",
        "diagnostics"
      ],
      "type": "object"
    },
    "category": "navigation",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.find_definition",
    "description": "Find the source location of an entity definition",
    "inputSchema": {
      "properties": {
        "entity_id": {
          "description": "Entity ID",
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "column": {
          "type": "integer"
        },
        "entity_id": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "name_span": {
          "type": "object"
        },
        "precision": {
          "enum": [
            "token",
            "entity"
          ],
          "type": "string"
        },
        "source_span": {
          "type": "object"
        }
      },
      "required": [
        "entity_id",
        "file_path",
        "line",
        "column",
        "source_span",
        "name_span",
        "precision"
      ],
      "type": "object"
    },
    "category": "navigation",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.find_references",
    "description": "Find the references to an entity: each place another entity's field names it, as the identifier token (what an IDE's find-references shows)",
    "inputSchema": {
      "properties": {
        "direction": {
          "default": "incoming",
          "description": "Which references: incoming: other entities' references to it; outgoing: its own references to other entities; both",
          "enum": [
            "incoming",
            "outgoing",
            "both"
          ],
          "type": "string"
        },
        "entity_id": {
          "description": "Entity ID",
          "type": "string"
        },
        "include_declaration": {
          "default": false,
          "description": "Also return the entity's own declaration (its name)",
          "type": "boolean"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "direction": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "locations": {
          "items": {
            "properties": {
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "precision": {
                "enum": [
                  "token",
                  "entity"
                ],
                "type": "string"
              },
              "referenced_entity_id": {
                "type": "string"
              },
              "referencing_entity_id": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "declaration",
                  "reference"
                ],
                "type": "string"
              },
              "source_span": {
                "type": "object"
              }
            },
            "required": [
              "referencing_entity_id",
              "referenced_entity_id",
              "field",
              "role",
              "precision",
              "source_span"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "direction",
        "locations"
      ],
      "type": "object"
    },
    "category": "navigation",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.outline",
    "description": "Get entity outline for a file",
    "inputSchema": {
      "properties": {
        "file": {
          "description": "File path",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
