---
source: crates/specforge-mcp/tests/prompt_golden.rs
expression: "shape(&reply, dir.path())"
---
{
  "description": "Get inference guidance for discovering spec entities from code",
  "instruction": "You are inferring spec entities from this codebase. Use the inference guides below to identify entities in the code, write .spec files, and validate them with specforge_validate. Each kind has signals describing what to look for in code. Do not duplicate entities that already exist.",
  "layout": "turns",
  "payload": {
    "existing_entities": {
      "behavior": 3,
      "feature": 1,
      "invariant": 1
    },
    "installed_extensions": [
      "@specforge/product",
      "@specforge/software",
      "@specforge/testing"
    ],
    "kinds": [
      {
        "description": "A user-facing capability that solves a specific problem",
