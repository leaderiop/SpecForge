      {
        "description": "A glossary entry defining domain-specific vocabulary",
        "extension": "@specforge/product",
        "fields": [
          "definition*",
          "context",
          "aliases",
          "see_also",
          "module"
        ],
        "inference_guide": "[guide]",
        "kind": "term"
      },
      {
        "description": "A user archetype representing a target audience segment",
        "extension": "@specforge/product",
        "fields": [
