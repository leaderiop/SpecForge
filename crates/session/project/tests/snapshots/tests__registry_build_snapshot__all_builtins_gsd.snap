                "required": false
              }
            ],
            "category": null,
            "description": "Record a conflict a plan revision reported (GSD REVISION_CONFLICT): open in the plan's phase; the same open conflict twice is one entity, answered reused",
            "export": "cmd__record_conflict",
            "id": "record_conflict",
            "title": ""
          },
          {
            "args": [
