  "manifest_surfaces": [
    {
      "extension": "@gsd/core",
      "surfaces": {
        "commands": [
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the entity judged (its path, or a short form that is not ambiguous)",
                "name": "entity",
                "required": true
              },
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "W311",
                      "W313",
                      "W315",
                      "W316",
                      "E501",
                      "W525",
                      "E518",
                      "E202",
                      "W203",
                      "W205"
                    ]
                  }
                },
                "default_value": null,
                "description": "the judged rule, as its local code",
                "name": "rule",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the verdict's outcome, one of the rule's",
                "name": "outcome",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the model that judged",
                "name": "model",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the JSON object `basis` of `specforge query <entity> --inputs gsd/<code> --format json`",
                "name": "basis",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "JSON list of findings (default []): objects with severity and message",
                "name": "findings",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "JSON list of what the verdict cites (default []): {\"entity\": ..}, {\"file\": ..} or {\"test\": ..}",
                "name": "cited",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "JSON object of the field values the rule binds (default {}), such as the scores of gsd/E202",
                "name": "values",
                "required": false
              }
