                "required": true
              }
            ],
            "category": null,
            "description": "Propose and roll up a spec's edge coverage: the edge probe's rows for each locked requirement of a phase spec (or each requirement of a phase), merged with the spec's recorded edges; answers the items and the coverage (applicable, resolved, unresolved, unclassified, byVerification)",
            "export": "cmd__edge_probe",
            "id": "edge_probe",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the locked requirement (its path, or a short form that is not ambiguous)",
                "name": "requirement",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the edge category: one of the taxonomy's eight, or unclassified",
                "name": "category",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "resolved, dismissed or unresolved",
                "name": "status",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "a resolved row's tier: explicit or backstop",
                "name": "verification",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the acceptance criterion or backstop note a resolved row requires",
                "name": "resolution",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "why a dismissed row is dismissed",
                "name": "reason",
                "required": false
              }
            ],
            "category": null,
            "description": "Write an edge-coverage row's resolution in one edit: the edge of a locked requirement and a category (created in the requirement's spec when none holds the pair) gets the status, tier, resolution and reason given, and only those; refused before anything is written when the probe engine refuses the resolution",
            "export": "cmd__resolve_edge",
            "id": "resolve_edge",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the spec prohibition (its path, or a short form that is not ambiguous)",
                "name": "prohibition",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "resolved, dismissed or unresolved",
                "name": "status",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "a resolved row's tier: test or judgment",
                "name": "verification",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "why a dismissed row is dismissed",
                "name": "reason",
                "required": false
              }
            ],
            "category": null,
            "description": "Write a spec prohibition's resolution in one edit: its status, tier and reason, and only those; the check descriptor (check_*) is cleared unless the row is resolved with the test tier; refused before anything is written when the probe engine refuses the resolution",
            "export": "cmd__resolve_prohibition",
            "id": "resolve_prohibition",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the phase whose plans the review must cover",
                "name": "phase",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "required; the reviewer's text",
                "name": "review",
                "required": false
              }
            ],
            "category": null,
            "description": "Check that a reviewer's text names every plan of a phase, each id standing alone (no word character or `-` beside it); answers complete, missing_ids and total",
            "export": "cmd__plan_coverage",
            "id": "plan_coverage",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the milestone to count (default: the given phase's, else the one in progress, else the last)",
