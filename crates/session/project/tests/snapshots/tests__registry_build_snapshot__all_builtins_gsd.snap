            "description": "Report the project's statistics as gsd-tools does: phases, plans, requirements, recorded commits and the last activity",
            "export": "cmd__stats",
            "id": "stats",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "report this phase alone, from its own milestone (default: every phase of the milestone in progress, else the last)",
                "name": "phase",
                "required": false
              }
            ],
            "category": null,
            "description": "Report each phase's plans, summaries and status, and the plan-based percent, as gsd-tools' progress json does",
            "export": "cmd__progress_report",
            "id": "progress_report",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the file, as the text that names it writes it",
                "name": "file",
                "required": true
              }
            ],
            "category": null,
            "description": "Print one ported GSD workflow, reference or template by its path (gsd-core/references/x.md; the gsd-core/ may be left out), converted for the calling host",
            "export": "cmd__reference",
            "id": "reference",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the phase whose plans were reviewed",
