                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the phase whose open tests `blockers` lists (default: the milestone's)",
                "name": "phase",
                "required": false
              }
            ],
            "category": null,
            "description": "Count the UAT tests still open (pending or missing, blocked, an issue with an open gap, a skip without a `Deferred follow-up` reason) in a milestone and in the shipped ones, and list a phase's",
            "export": "cmd__verification_debt",
            "id": "verification_debt",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the phase or the plan whose verdicts to list",
                "name": "subject",
                "required": true
              },
              {
                "arg_type": "bool",
                "default_value": null,
                "description": "list only the verdicts that are not fresh: stale, missing, unrecorded or unreadable",
                "name": "stale_only",
                "required": false
              }
            ],
            "category": null,
            "description": "List the verifier's verdicts within a phase or a plan and whether each is fresh (its inputs unchanged since it was recorded, whatever its outcome): its state, each input that changed since it was recorded with its selector, and what it cites. `specforge gsd re-verify <subject> --stale-only` keeps the verdicts that are not fresh, so the verifier judges exactly those",
            "export": "cmd__re_verify",
            "id": "re_verify",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the phase whose plans and tasks to thread",
                "name": "phase",
                "required": true
              }
            ],
            "category": null,
            "description": "Answer a phase's plans and tasks in the order they run, as the agent plan the kernel checks: each plan by its strict wave then its id, followed by its tasks. Write `specforge gsd thread-plan <phase> --format json` to a file and run `specforge trace --plan <file>`: an entry before a plan or task it depends on is an ordering gap, an entry naming no entity is E003",
            "export": "cmd__thread_plan",
            "id": "thread_plan",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "build",
                      "test"
                    ]
                  }
                },
                "default_value": null,
                "description": "the gate: build or test",
                "name": "target",
                "required": true
              },
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "post_merge",
                      "regression"
                    ]
                  }
                },
                "default_value": "post_merge",
                "description": "post_merge, or regression: no Xcode, and pytest on the named files",
                "name": "scope",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the .xcodeproj the block found; empty is absent",
                "name": "xcode_project",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the text of xcodebuild -list -json",
                "name": "xcode_list",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the text of xcrun simctl list devices available -j",
                "name": "simulators",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the regression's test files, one per line",
                "name": "files",
                "required": false
              }
            ],
            "category": null,
            "description": "Answer the argv of the build or test gate: the workflow.<target>_command setting, else the project's runner in upstream's order. Read-only; it runs nothing",
            "export": "cmd__gate_command",
            "id": "gate_command",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the path; a relative one is from the worktree's top",
                "name": "target",
                "required": true
              }
            ],
            "category": null,
            "description": "Answer whether a path is inside this worktree, read lexically as the guard reads a target",
            "export": "cmd__worktree_contains",
            "id": "worktree_contains",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the <automated> command, as the plan wrote it; when a task is named, the task whose commands are read",
                "name": "command",
                "required": true
              },
              {
                "arg_type": "bool",
                "default_value": null,
                "description": "the argument names a task: read each of its `<automated>` commands",
                "name": "task",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the repository's common directory (`specforge git repo --pick .common_dir`): the main checkout is it without its `.git`. Empty is refused: it means that read failed",
                "name": "common_dir",
                "required": false
              }
            ],
            "category": null,
            "description": "Halt when a plan's <automated> command would leave the worktree: its words are read, never run",
            "export": "cmd__automated_guard",
            "id": "automated_guard",
            "title": ""
          },
          {
            "args": [],
            "category": null,
            "description": "Answer whether the branch HEAD is on may take a commit: protected, an agent's, overridden. Read-only",
            "export": "cmd__branch_check",
            "id": "branch_check",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the milestone, by its id",
                "name": "milestone",
                "required": true
              }
            ],
            "category": null,
            "description": "Answer the local branches a milestone's work sits on, by the branching strategy: read-only",
            "export": "cmd__milestone_branches",
            "id": "milestone_branches",
            "title": ""
          },
          {
            "args": [],
            "category": null,
            "description": "Classify the project's situation and name the next actions, as gsd-tools smart-entry does (idle-stranded is never derived: a command runs no git)",
            "export": "cmd__smart_entry",
            "id": "smart_entry",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "one task: its one item gets a slug and a branch name",
                "name": "description",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "a task list: one item per entry, its list marker and blank lines dropped; attach it with `=`, as a list starts with a hyphen",
                "name": "tasks",
                "required": false
              },
              {
                "arg_type": "bool",
                "default_value": null,
                "description": "the items are a batch: needs a task list of at least 2 entries, and each item gains `batch`",
                "name": "batch",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the branch template (`git.quick_branch_template`): `{num}` is the id, `{slug}` the slug; empty names no branch",
                "name": "template",
                "required": false
              }
            ],
            "category": null,
            "description": "What a quick task or a batch starts from: one quick id per task, each free in the graph, with its slug, branch name and the host's date",
            "export": "cmd__quick_init",
            "id": "quick_init",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the batch id quick-init answered (`261112-batch`)",
                "name": "batch",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "required; the batch's quick plans, as a JSON list of ids, in item order",
                "name": "items",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "required; the commit the batch starts from: 40 lowercase hex digits",
                "name": "base",
                "required": false
              }
            ],
            "category": null,
            "description": "Record a quick batch: its quick plans in item order, the commit it starts from and the host's clock (GSD BATCH.json)",
            "export": "cmd__start_batch",
            "id": "start_batch",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the lessons of the cluster, as a JSON list of ids",
                "name": "lessons",
                "required": true
              },
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "promoted",
                      "deferred",
                      "dismissed"
                    ]
                  }
                },
                "default_value": null,
                "description": "required; promoted, deferred or dismissed",
                "name": "disposition",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "a promotion's decision: the decision the lessons became",
                "name": "target",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "a deferral's phase: the lessons are open again once it is complete",
                "name": "until",
                "required": false
              }
            ],
            "category": null,
            "description": "Record what the developer chose for a cluster of lessons: promoted into a decision, deferred until a phase, or dismissed (the host's clock)",
            "export": "cmd__graduate_lessons",
            "id": "graduate_lessons",
            "title": ""
          },
          {
            "args": [
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "list",
                      "status",
                      "enable",
                      "disable",
                      "reset",
                      "profile"
                    ]
                  }
                },
                "default_value": null,
                "description": "what to do (profile is refused)",
                "name": "action",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "the cluster (enable and disable)",
                "name": "cluster",
                "required": false
              }
            ],
            "category": null,
            "description": "Show which skill clusters are shown, or print the lines that show or hide one; it changes no setting itself",
            "export": "cmd__surface",
            "id": "surface",
            "title": ""
          }
        ],
        "mcp_resources": [],
        "mcp_tools": []
      }
    }
  ],
  "rules": [
    {
      "check": "conditional_field_required",
      "code": "gsd/E105",
      "constraint": {
        "kind": "when_field_equals",
        "pattern": "tier",
        "values": [
          "out_of_scope"
        ]
      },
      "edge_type": null,
      "field": "reason",
      "message_template": "requirement '{id}' is out of scope but gives no reason",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "requirement",
      "wasm_function": null
    },
    {
      "check": "field_value_constraint",
      "code": "gsd/E107",
      "constraint": {
        "kind": "matches",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?Z$",
        "values": []
      },
      "edge_type": null,
      "field": "checkpoint.timestamp",
      "message_template": "{kind} '{id}' has '{value}' where a time like 2026-10-28T09:30:00Z belongs",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "discussion",
      "wasm_function": null
    },
    {
      "check": "field_value_constraint",
      "code": "gsd/E107",
      "constraint": {
        "kind": "matches",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?Z$",
        "values": []
      },
      "edge_type": null,
      "field": "resolved.at",
      "message_template": "{kind} '{id}' has '{value}' where a time like 2026-10-28T09:30:00Z belongs",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "blocker",
      "wasm_function": null
    },
    {
      "check": "field_value_constraint",
      "code": "gsd/E107",
      "constraint": {
        "kind": "matches",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?Z$",
        "values": []
      },
      "edge_type": null,
      "field": "started",
      "message_template": "{kind} '{id}' has '{value}' where a time like 2026-10-28T09:30:00Z belongs",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "uat_session",
      "wasm_function": null
    },
    {
      "check": "missing_required_field",
      "code": "gsd/E201",
      "constraint": null,
      "edge_type": null,
      "field": "canonical_refs",
      "message_template": "context '{id}' has no canonical_refs; with no external spec, write one whose topic says so",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "context",
      "wasm_function": null
    },
    {
      "check": "field_value_constraint",
      "code": "gsd/E201",
      "constraint": {
        "kind": "non_empty",
        "pattern": null,
        "values": []
      },
      "edge_type": null,
      "field": "canonical_refs",
      "message_template": "context '{id}' has an empty canonical_refs",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": "context",
      "wasm_function": null
    },
    {
      "check": "judged",
      "code": "gsd/E202",
      "constraint": null,
      "edge_type": null,
      "field": null,
      "judged": {
        "judge": "prompt:spec_phase",
        "outcomes": [
          "passed",
          "failed"
        ],
        "passing": [
          "passed"
        ],
        "targets": [
          {
            "inputs": [
              {
                "name": "spec",
                "selector": "self"
              },
              {
                "name": "items",
                "selector": "self<locked_req|interview.spec"
              },
              {
                "name": "phase",
                "selector": "self.phase"
              }
            ],
            "kind": "phase_spec"
          }
        ],
        "values": [
          "phase_spec.scores"
        ]
      },
      "message_template": "phase spec '{id}' is not judged against its ambiguity gates",
      "owner": "@gsd/core",
      "severity": "Error",
      "target_kind": null,
      "wasm_function": null
    },
    {
      "check": "conditional_field_required",
      "code": "gsd/E307",
