{
  "$schema": "./schema/specforge.schema.json",
  "name": "specforge",
  "version": "0.1.0",
  "spec_root": "spec",
  "extensions": [
    "@specforge/checks",
    "@code/core",
    "@gsd/core",
    "@rust/cargo",
    "@rust/source",
    "@rust/test"
  ],
  "settings": {
    "@rust/cargo": {
      "exclude": [
        "crates/app/ops/tests/fixtures",
        "examples",
        "extensions/rust/manifest/fixtures",
        "fixtures",
        "gsd/core/tests/projects",
        "gsd/parity/fixtures",
        "xtask/tests/fixtures"
      ]
    }
  }
}
