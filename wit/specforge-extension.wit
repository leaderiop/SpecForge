package specforge:extension@0.1.0;

// ============================================================================
// SpecForge extension IDL (C7-03 closure, hardening-plan Phase W1).
//
// The contract between the host (specforge CLI / LSP / MCP) and extension
// components. A component implements ONE world matching its capabilities:
//
//   specforge:extension/validator   — custom validation rules (check: "custom")
//   specforge:extension/pass        — compiler passes (__pass_<name>)
//   specforge:extension/analyzer    — source-file scan/classify/map
//   specforge:extension/contributor — declarative contributions (handshake +
//                                     describe only)
//
// Boundary policy for v0.1: per-call, high-frequency surfaces (validate,
// pass, scan/classify/map) are fully typed. Load-once metadata
// (handshake/describe descriptors) crosses as JSON strings pending v0.2
// typing — the payloads are the same JSON the host already produces.
// ============================================================================

interface types {
    enum severity {
        error,
        warning,
        info,
    }

    record span {
        file: string,
        start-line: u32,
        start-col: u32,
        end-line: u32,
        end-col: u32,
    }

    record diagnostic {
        code: string,
        severity: severity,
        message: string,
        span: option<span>,
        suggestion: option<string>,
    }

    // ── custom-rule validator (validate__* exports) ──

    record validator-param {
        name: string,
        ty: string,
    }

    record validator-method {
        name: string,
        params: list<validator-param>,
        returns: option<string>,
    }

    record validator-field {
        key: string,
        /// Stringified field value: scalars as strings, reference lists as
        /// the declared IDs (comma-joined).
        value: string,
        annotations: list<string>,
    }

    record validator-entity {
        id: string,
        kind: string,
        fields: list<validator-field>,
        methods: list<validator-method>,
    }

    record validator-ref {
        id: string,
        /// Kind of the referenced node; none when the reference dangles.
        kind: option<string>,
    }

    record validator-context {
        entity: validator-entity,
        referenced: list<validator-ref>,
        declared-types: list<string>,
        primitives: list<string>,
    }

    variant validator-verdict {
        pass,
        fail,
    }

    record validator-fail {
        field: option<string>,
        value: option<string>,
    }

    // ── compiler passes (__pass_<name> exports) ──

    record edge {
        source: string,
        target: string,
        label: string,
    }

    record pass-entity {
        id: string,
        kind: string,
        /// Stringified fields as a JSON object (build_validation_entities).
        fields-json: string,
        incoming-edge-count: u32,
        outgoing-edge-count: u32,
        span: option<span>,
        testable: bool,
    }

    record pass-input {
        entities: list<pass-entity>,
        edges: list<edge>,
    }

    // ── analyzer (scan / classify / map) ──

    record scanned-item {
        name: string,
        item-kind: string,
        line: u32,
        visibility: option<string>,
        signature: option<string>,
    }

    record scan-request {
        file-path: string,
        content: string,
    }

    record scan-response {
        items: list<scanned-item>,
        language: option<string>,
    }

    record classify-request {
        items: list<scanned-item>,
        file-path: string,
    }

    record classified-item {
        name: string,
        item-kind: string,
        suggested-entity-kind: option<string>,
        confidence: f64,
        line: u32,
    }

    record classify-response {
        items: list<classified-item>,
    }

    record map-symbol-request {
        name: string,
        item-kind: string,
        file-path: string,
        existing-entity-ids: list<string>,
    }

    record map-symbol-response {
        entity-id: option<string>,
        mapping-strategy: string,
    }
}

interface validator {
    use types.{validator-context, validator-verdict, validator-fail};

    /// Validate one entity; `function-name` selects the validator the
    /// manifest declared (e.g. "validate__event_triggers").
    validate: func(function-name: string, context: validator-context) ->
        result<validator-verdict, validator-fail>;
}

interface pass {
    use types.{pass-input, diagnostic};

    /// Run the compiler pass `name` over the entity snapshot.
    run: func(name: string, input: pass-input) -> list<diagnostic>;
}

interface analyzer {
    use types.{
        scan-request, scan-response, classify-request, classify-response,
        map-symbol-request, map-symbol-response,
    };

    scan: func(request: scan-request) -> scan-response;
    classify: func(request: classify-request) -> classify-response;
    map-symbol: func(request: map-symbol-request) -> map-symbol-response;
}

interface declarative {
    /// JSON-encoded HandshakeResponse (v0.1 legacy boundary).
    handshake: func() -> string;
    /// JSON-encoded DescribeResponse for `category`
    /// (v0.1 legacy boundary).
    describe: func(category: string) -> result<string, string>;
}

// ============================================================================
// Worlds — a component implements exactly one, matching its capabilities.
// The host selects the binding surface from the manifest's contribution
// flags and the component's world.
// ============================================================================

/// Declarative contributions only: handshake + describe categories.
world contributor-world {
    import types;
    export declarative;
}

/// Declares custom validation rules (check: "custom") — validate__* logic.
world validator-world {
    import types;
    export validator;
}

/// Declares compiler passes (__pass_<name>).
world pass-world {
    import types;
    export pass;
}

/// Declares source-file analyzer contributions (scan/classify/map).
world analyzer-world {
    import types;
    export analyzer;
}

/// Combination world: declarative + validator (e.g. @specforge/software).
world contributor-validator-world {
    import types;
    export declarative;
    export validator;
}

/// Combination world: declarative + pass (e.g. @specforge/formal).
world contributor-pass-world {
    import types;
    export declarative;
    export pass;
}

/// Combination world: declarative + analyzer (e.g. @specforge/rust,
/// @specforge/typescript).
world contributor-analyzer-world {
    import types;
    export declarative;
    export analyzer;
}
