              "properties": {
                "category": "Best Practices"
              },
              "shortDescription": {
                "text": "Require the use of `===` and `!==`"
              }
            },
            {
              "id": "no-console",
              "helpUri": "https://eslint.org/docs/latest/rules/no-console",
              "properties": {
                "category": "Suggestions"
              },
              "shortDescription": {
                "text": "Disallow the use of `console`"
