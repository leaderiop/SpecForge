// The brand book, as rules a message can cite.

brand_rule name_the_product "Name the product right" {
  rule "Write 'Lumen Pro'. Never 'Lumen PRO', 'LumenPro' or 'the Pro'."
  why  "Search and the app stores only match the exact name."
}

brand_rule no_unapproved_discounts "No unapproved discounts" {
  rule "Quote only the prices on the approved price sheet."
  why  "A price we print is a price we must honour."
}

brand_rule plain_words "Plain words" {
  rule "Short sentences. No jargon. Say what the reader gets."
  why  "Our readers skim on a phone."
}
