  "rendered": "**Gate** (security): check={\"predicate\":{\"kind\":\"artifact-frontmatter-equals\",\"artifact\":\"SECURITY.md\",\"field\":\"threats_open\",\"equals\":0}}, blocking=true, onError=halt\n- when: `workflow.security_enforcement`"
}
